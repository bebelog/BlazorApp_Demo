<div class="neon-search-container">
    <div class="neon-search-box">
        <span class="neon-search-icon">🔍</span>
        <input type="text" 
               class="neon-search-input" 
               id="filter" 
               placeholder="Search products by name (e.g. Maybelline, Bronzer, Blush, Foundation)..." 
               @bind-value="filter" 
               @onkeyup="@(e => { if (e.Key == "Enter") HandleSearch(); })" />
        <button type="button" class="neon-search-btn" @onclick="HandleSearch">Search</button>
    </div>
</div>

@code {
    private string filter;

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    private void HandleSearch() {
        OnSearch.InvokeAsync(filter);
    }
}