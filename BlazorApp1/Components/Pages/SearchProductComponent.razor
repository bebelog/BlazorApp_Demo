@page "/products"
@rendermode InteractiveServer
@inject ISearchProduct searchProduct

<h3>Search Products</h3>

<SearchBarComponent OnSearch="HandleSearch"></SearchBarComponent>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Brand</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @if (products != null && products.Any())
        {
            @foreach (var prod in products)
            {
                <ProductItemComponent Product="prod"></ProductItemComponent>
            }
        }
        else
        {
            <tr>
                <td colspan="3">Cannot find products</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IEnumerable<Product> products;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        products = searchProduct.Execute();
    }

    private void HandleSearch(string filter)
    {
        products = searchProduct.Execute(filter);
    }
}
