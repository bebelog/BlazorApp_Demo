@page "/product/{id:int}"
@rendermode InteractiveServer
@inject IViewProduct viewProduct

<h3>Product Details</h3>

@if (product != null)
{
    <div class="card" style="width: 22rem;">
        <img src="@product.ImageLink" class="card-img-top" alt="@product.Name" />
        <div class="card-body">
            <h5 class="card-title">@product.Name</h5>
            <h6 class="card-subtitle mb-2 text-muted">Brand: @product.Brand</h6>
            <h5 class="text-danger">@product.Price.ToString("c")</h5>
            <p class="card-text">@product.Description</p>
            <NavLink href="products" class="btn btn-primary">Back to Product Page</NavLink>
        </div>
    </div>
}

@code {
    private Product product;

    [Parameter]
    public int Id { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Id > 0)
            product = viewProduct.Execute(Id);
    }
}
